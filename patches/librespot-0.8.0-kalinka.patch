+            || audio_backend::find(Some("pipe".into())).unwrap()(None, AudioFormat::S16),
+        );
+        let events = player.get_player_event_channel();
+        let mut connect_state = ConnectState::new(ConnectConfig::default(), &session);
+        connect_state.set_active(true);
+        let task = SpircTask {
+            player,
+            mixer,
+            connect_state,
+            connect_established: false,
+            play_request_id: None,
+            play_status: SpircPlayStatus::Stopped,
+            connection_id_update: Box::pin(futures_util::stream::pending()),
