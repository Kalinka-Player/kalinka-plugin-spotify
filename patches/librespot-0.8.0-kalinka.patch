+            update_volume: false,
+            update_state: false,
+            spirc_id: 0,
+            kalinka_bridge: true,
+            kalinka_suspended: false,
+            context_bans_refreshed: None,
+            #[cfg(test)]
+            context_bans_pending: None,
+        };
