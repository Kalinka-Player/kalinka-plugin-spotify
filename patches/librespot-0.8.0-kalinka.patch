diff --git a/connect/src/context_bans.rs b/connect/src/context_bans.rs
new file mode 100644
index 0000000..7e1aab1
--- /dev/null
+++ b/connect/src/context_bans.rs
@@ -0,0 +1,155 @@
+// Spotify stores Hide Song separately from resolved playlist metadata.
+// Keep the context URI: hiding a song in one playlist must not hide its album.
+use crate::core::{Error, Session};
+use std::{
+    collections::{HashMap, HashSet},
+    time::Duration,
+};
+
+pub(crate) type ContextBans = HashMap<String, HashSet<String>>;
+
+fn apply_page(bytes: &[u8], bans: &mut ContextBans) -> Result<Option<String>, Error> {
+    let page: serde_json::Value = serde_json::from_slice(bytes)?;
+    if !page["sync_token"].is_string() {
+        return Err(Error::failed_precondition(
+            "Invalid hidden-song collection response",
+        ));
+    }
+    if let Some(items) = page.get("items") {
+        let items = items
+            .as_array()
+            .ok_or_else(|| Error::failed_precondition("Invalid hidden-song items"))?;
+        for item in items {
+            let uri = item["uri"].as_str().filter(|s| !s.is_empty());
+            let context = item["context_uri"].as_str().filter(|s| !s.is_empty());
+            let (Some(uri), Some(context)) = (uri, context) else {
+                return Err(Error::failed_precondition(
+                    "Invalid contextual hidden-song item",
+                ));
+            };
+            let removed = match item.get("is_removed") {
+                None => false,
+                Some(v) => v
+                    .as_bool()
+                    .ok_or_else(|| Error::failed_precondition("Invalid hidden-song tombstone"))?,
+            };
+            let tracks = bans.entry(context.to_owned()).or_default();
+            if removed {
+                tracks.remove(uri);
+            } else {
+                tracks.insert(uri.to_owned());
+            }
+        }
+    }
+    match page.get("next_page_token") {
+        None => Ok(None),
+        Some(v) => v
+            .as_str()
+            .map(|s| (!s.is_empty()).then(|| s.to_owned()))
+            .ok_or_else(|| Error::failed_precondition("Invalid hidden-song page token")),
+    }
+}
+
+async fn fetch(session: &Session) -> Result<ContextBans, Error> {
+    let mut bans = ContextBans::new();
+    let mut pagination_token = String::new();
+    let mut seen = HashSet::new();
+    for _ in 0..200 {
+        let body = serde_json::json!({
+            "username": session.username(), "set": "playcontextbans",
+            "limit": 500, "pagination_token": pagination_token,
+        })
+        .to_string();
+        let headers = [(
+            "content-type".parse().expect("constant header name"),
+            "application/json".parse().expect("constant header value"),
+        )]
+        .into_iter()
+        .collect();
+        let bytes = session
+            .spclient()
+            .request_as_json(
+                &"POST".parse().expect("constant HTTP method"),
+                "/collection/v2/paging",
+                Some(headers),
+                Some(&body),
+            )
+            .await?;
+        match apply_page(&bytes, &mut bans)? {
+            None => {
+                bans.retain(|_, tracks| !tracks.is_empty());
+                return Ok(bans);
+            }
+            Some(next) if seen.insert(next.clone()) => pagination_token = next,
+            Some(_) => {
+                return Err(Error::failed_precondition(
+                    "Repeated hidden-song page token",
+                ));
+            }
+        }
+    }
+    Err(Error::resource_exhausted(
+        "Hidden-song collection exceeds page limit",
+    ))
+}
+
+pub(crate) async fn refresh(
+    session: Session,
+    delay: Duration,
+) -> (tokio::time::Instant, Result<ContextBans, Error>) {
+    tokio::time::sleep(delay).await;
+    let started = tokio::time::Instant::now();
+    // Keep a failed or partial refresh from replacing the last complete list.
+    let result = tokio::time::timeout(Duration::from_secs(5), fetch(&session))
+        .await
+        .map_err(|_| Error::deadline_exceeded("Hidden-song refresh timed out"))
+        .and_then(|result| result);
+    (started, result)
+}
+
+#[cfg(test)]
+mod kalinka_hidden_tests {
+    use super::*;
+
+    #[test]
+    fn pages_keep_contexts_separate_and_apply_tombstones() {
+        let mut bans = ContextBans::new();
+        assert_eq!(
+            apply_page(
+                br#"{"sync_token":"s","next_page_token":"two","items":[
+            {"uri":"track:a","context_uri":"playlist:a","item_data":{}},
+            {"uri":"track:a","context_uri":"playlist:b"},
+            {"uri":"track:b","context_uri":"playlist:a"}]}"#,
+                &mut bans
+            )
+            .unwrap(),
+            Some("two".into())
+        );
+        assert_eq!(
+            apply_page(
+                br#"{"sync_token":"s","items":[
+            {"uri":"track:a","context_uri":"playlist:a","is_removed":true}]}"#,
+                &mut bans
+            )
+            .unwrap(),
+            None
+        );
+        assert!(!bans["playlist:a"].contains("track:a"));
+        assert!(bans["playlist:a"].contains("track:b"));
+        assert!(bans["playlist:b"].contains("track:a"));
+    }
+
+    #[test]
+    fn accepts_empty_collection_but_rejects_malformed_responses() {
+        assert!(apply_page(br#"{"sync_token":"s"}"#, &mut ContextBans::new()).is_ok());
+        for bytes in [
+            br#"{}"#.as_slice(),
+            br#"{"sync_token":"s","items":{}}"#,
+            br#"{"sync_token":"s","items":[{"uri":"track:a"}]}"#,
+            br#"{"sync_token":"s","next_page_token":true}"#,
+            br#"{"sync_token":"s","items":[{"uri":"t","context_uri":"c","is_removed":"false"}]}"#,
+        ] {
+            assert!(apply_page(bytes, &mut ContextBans::new()).is_err());
+        }
+    }
+}
