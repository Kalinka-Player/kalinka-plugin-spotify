--- /dev/null
+++ b/playback/src/kalinka.rs
@@ -0,0 +1,207 @@
+//! Private, opt-in Kalinka pipe bridge. No audio hardware or Spotify protocol here.
+use crate::{decoder::AudioPacket, player::PlayerEvent};
+use futures_util::task::AtomicWaker;
+use serde_json::{Value, json};
+use std::{
+    io::{BufRead, BufReader, Write},
+    os::fd::FromRawFd,
+    os::unix::net::UnixStream,
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+    task::Context,
+    time::Duration,
+};
+
+struct Bridge {
+    output: Mutex<UnixStream>,
+    sent: AtomicU64,
+    ack: AtomicU64,
+    waker: AtomicWaker,
+}
+static BRIDGE: OnceLock<Bridge> = OnceLock::new();
+static EPOCH: AtomicU64 = AtomicU64::new(0);
+pub fn epoch() -> u64 {
+    EPOCH.load(Ordering::SeqCst)
+}
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+pub fn active() -> bool {
+    ACTIVE.load(Ordering::SeqCst)
+}
+
+pub fn init() -> tokio::sync::mpsc::Receiver<Value> {
+    let (tx, rx) = tokio::sync::mpsc::channel(32);
+    let Ok(fd) = std::env::var("KALINKA_CONTROL_FD") else {
+        return rx;
+    };
+    ACTIVE.store(true, Ordering::SeqCst);
+    let fd: i32 = fd.parse().expect("invalid control descriptor");
+    // The supervisor transfers ownership of this inherited socket descriptor.
+    let socket = unsafe { UnixStream::from_raw_fd(fd) };
+    socket
+        .set_write_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    let input = socket.try_clone().unwrap();
+    BRIDGE
+        .set(Bridge {
+            output: Mutex::new(socket),
+            sent: AtomicU64::new(0),
+            ack: AtomicU64::new(0),
+            waker: AtomicWaker::new(),
+        })
+        .ok()
+        .expect("one bridge");
+    std::thread::spawn(move || {
+        let mut input = BufReader::new(input);
+        loop {
+            let mut line = String::new();
+            // Commands are tiny; a malicious/broken supervisor cannot grow memory.
+            let mut limited = (&mut input).take(4096);
+            use std::io::Read;
+            if limited.read_line(&mut line).unwrap_or(0) == 0 || !line.ends_with('\n') {
+                std::process::exit(70);
+            }
+            let Ok(value) = serde_json::from_str::<Value>(&line) else {
+                std::process::exit(70)
+            };
+            if value["op"] == "ack" {
+                let b = BRIDGE.get().unwrap();
+                let ack = value["id"].as_u64().unwrap_or(0);
+                if ack <= b.sent.load(Ordering::SeqCst) {
+                    b.ack.fetch_max(ack, Ordering::SeqCst);
+                    b.waker.wake();
+                }
+            } else if tx.blocking_send(value).is_err() {
+                return;
+            }
+        }
+    });
+    emit(json!({"event":"ready", "protocol":1}));
+    rx
+}
+
+pub fn emit(mut value: Value) {
+    value["epoch"] = json!(epoch());
+    if let Some(b) = BRIDGE.get() {
+        let mut out = b.output.lock().unwrap();
+        if serde_json::to_writer(&mut *out, &value).is_err() || out.write_all(b"\n").is_err() {
+            std::process::exit(70);
+        }
+    }
+}
+
+pub fn poll_ready(cx: &Context<'_>) -> bool {
+    let Some(b) = BRIDGE.get() else { return true };
+    b.waker.register(cx.waker());
+    b.ack.load(Ordering::SeqCst) >= b.sent.load(Ordering::SeqCst)
+}
+
+fn reset_credit() {
+    EPOCH.fetch_add(1, Ordering::SeqCst);
+    if let Some(b) = BRIDGE.get() {
+        b.ack.store(b.sent.load(Ordering::SeqCst), Ordering::SeqCst);
+        b.waker.wake();
+    }
+}
+
+pub fn packet(packet: &AudioPacket, position_ms: u32) {
+    if let Some(b) = BRIDGE.get() {
+        let AudioPacket::Raw(data) = packet else {
+            emit(json!({"event":"error", "code":"incompatible_format"}));
+            std::process::exit(71);
+        };
+        if data.len() > 1024 * 1024 {
+            std::process::exit(71);
+        }
+        let id = b.sent.fetch_add(1, Ordering::SeqCst) + 1;
+        emit(json!({"event":"packet", "id":id, "length":data.len(), "position_ms":position_ms}));
+    }
+}
+
+pub fn suspended(id: u64) {
+    reset_credit();
+    emit(json!({"event":"suspended", "id":id}));
+}
+
+pub fn event(event: &PlayerEvent) {
+    if BRIDGE.get().is_none() {
+        return;
+    }
+    use PlayerEvent::*;
+    let value = match event {
+        Loading { position_ms, .. } => {
+            reset_credit();
+            json!({"event":"loading", "position_ms":position_ms})
+        }
+        Seeked { position_ms, .. } => {
+            reset_credit();
+            json!({"event":"seeked", "position_ms":position_ms})
+        }
+        Playing { position_ms, .. } => json!({"event":"playing", "position_ms":position_ms}),
+        Paused { position_ms, .. } => json!({"event":"paused", "position_ms":position_ms}),
+        VolumeChanged { volume } => json!({"event":"volume", "volume":volume}),
+        Stopped { .. } => json!({"event":"stopped"}),
+        EndOfTrack { .. } => json!({"event":"end"}),
+        Unavailable { .. } => json!({"event":"error", "code":"track_unavailable"}),
+        SessionConnected { .. } => json!({"event":"connected"}),
+        SessionDisconnected { .. } => json!({"event":"disconnected"}),
+        TrackChanged { audio_item: item } => {
+            reset_credit();
+            use crate::metadata::audio::UniqueFields;
+            let (album, artists) = match &item.unique_fields {
+                UniqueFields::Track { album, artists, .. } => (
+                    album.clone(),
+                    artists
+                        .iter()
+                        .map(|a| a.name.clone())
+                        .collect::<Vec<_>>()
+                        .join(", "),
+                ),
+                UniqueFields::Episode { show_name, .. } => (show_name.clone(), String::new()),
+                _ => (String::new(), String::new()),
+            };
+            json!({"event":"track", "uri":item.uri, "title":item.name,
+                "duration_ms":item.duration_ms, "album":album, "artist":artists,
+                "cover":item.covers.first().map(|c| &c.url)})
+        }
+        _ => return,
+    };
+    emit(value);
+}
+
+/// Offline verification of the actual compiled decoder and pipe backend.
+#[cfg(feature = "passthrough-decoder")]
+pub fn self_test(path: &str, seek: Option<u32>) {
+    ACTIVE.store(true, Ordering::SeqCst);
+    let _commands = init();
+    use crate::metadata::audio::AudioFileFormat;
+    use crate::{
+        audio_backend,
+        config::AudioFormat,
+        convert::Converter,
+        decoder::{AudioDecoder, PassthroughDecoder},
+    };
+    let input = std::fs::File::open(path).expect("fixture");
+    let mut decoder = PassthroughDecoder::new(input, AudioFileFormat::OGG_VORBIS_160).unwrap();
+    if let Some(position) = seek {
+        decoder.next_packet().unwrap();
+        decoder.seek(position).unwrap();
+    }
+    let mut sink = audio_backend::find(Some("pipe".into())).unwrap()(None, AudioFormat::S16);
+    let mut converter = Converter::new(None);
+    sink.start().unwrap();
+    while let Some((position, audio)) = decoder.next_packet().unwrap() {
+        packet(&audio, position.position_ms);
+        sink.write(audio, &mut converter).unwrap();
+        // Exercise the same packet/credit contract as live playback when
+        // the verifier supplies a control socket. No next write or final
+        // stop/exit may flush bytes the supervisor still needs to acknowledge.
+        if let Some(b) = BRIDGE.get() {
+            while b.ack.load(Ordering::SeqCst) < b.sent.load(Ordering::SeqCst) {
+                std::thread::sleep(Duration::from_millis(1));
+            }
+        }
+    }
+    sink.stop().unwrap();
+}
