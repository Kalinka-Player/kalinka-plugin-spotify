+            playback: MessageField::some(Playback {
+                current_track: MessageField::some(ContextTrack {
+                    uri: Some("spotify:local:artist:album:old:180".into()),
+                    ..Default::default()
+                }),
+                position_as_of_timestamp: Some(65000),
+                is_paused: Some(true),
+                ..Default::default()
+            }),
+            ..Default::default()
+        };
+        // A return transfer starts playing before its album context resolves.
+        task.handle_transfer(transfer.clone()).unwrap();
+        assert!(task.transfer_state.is_some());
+        assert!(task.context_resolver.has_next());
+        // Start a new explicit list before that request completes. This uses
+        // the same load path as a playlist Play, without a network fetch.
+        task.handle_load(
