+        let (mut task, events) = offline_task();
+        let tracks: Vec<String> = (0..5)
+            .map(|i| format!("spotify:local:artist:album:track{i}:180"))
+            .collect();
+        task.handle_load(
+            LoadRequest {
+                context: PlayContext::Tracks(tracks.clone()),
+                options: LoadRequestOptions {
+                    start_playing: false,
+                    playing_track: Some(PlayingTrack::Index(position as u32)),
+                    ..Default::default()
+                },
+            },
+            None,
+            None,
+        )
+        .await
+        .unwrap();
+        task.play_status = SpircPlayStatus::Playing {
+            nominal_start_time: task.now_ms(),
+            preloading_of_next_track_triggered: false,
+        };
+        task.connect_state.set_status(&task.play_status);
+        task.play_request_id = Some(42);
+        // The collection has changed, but the periodic refresh has not run.
+        task.context_bans_pending = Some(
+            [(
+                "spotify:web-api".into(),
+                hidden.iter().map(|i| tracks[*i].clone()).collect(),
+            )]
+            .into_iter()
+            .collect(),
+        );
+        (task, events, tracks)
+    }
